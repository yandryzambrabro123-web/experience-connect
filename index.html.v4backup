<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Experience Connect — Vive el Mundo | Ecuador</title>
<meta name="description" content="Estudia en el exterior con Experience Connect. Programas universitarios en Argentina, Europa y mas. +500 estudiantes exitosos desde Ecuador.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,700;0,800;0,900;1,800&family=Nunito+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
:root{
--b:#1565C0;--b2:#0D47A1;--b3:#1976D2;--b4:#42A5F5;--b5:#E3F2FD;
--g:#25D366;--w:#fff;--off:#F0F6FF;--text:#0A1628;--muted:#546E7A;
--border:#E1EAF5;--dark:#050D1A;
--s1:0 4px 20px rgba(21,101,192,.1);
--s2:0 12px 48px rgba(21,101,192,.15);
--s3:0 24px 80px rgba(21,101,192,.2);
}
body{font-family:'Nunito Sans',sans-serif;color:var(--text);background:var(--w);overflow-x:hidden;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-thumb{background:var(--b);border-radius:99px}
img{max-width:100%;display:block}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:900;height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 5%;background:rgba(255,255,255,.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(21,101,192,.08);box-shadow:0 2px 24px rgba(21,101,192,.07);transition:all .3s}
.nl img{height:56px;width:auto;object-fit:contain}
.nm{display:flex;align-items:center;gap:24px;list-style:none}
.nm a{font-size:.78rem;font-weight:700;color:var(--muted);text-decoration:none;transition:color .2s}
.nm a:hover{color:var(--b)}
.nb{background:var(--b);color:#fff;padding:10px 22px;border-radius:50px;font-size:.76rem;font-weight:800;border:none;cursor:pointer;font-family:'Nunito Sans',sans-serif;transition:all .25s;box-shadow:0 4px 18px rgba(21,101,192,.35)}
.nb:hover{background:var(--b2);transform:translateY(-2px);box-shadow:0 8px 28px rgba(21,101,192,.45)}
.nw{display:flex;align-items:center;gap:6px;background:var(--g);color:#fff;padding:10px 18px;border-radius:50px;font-size:.74rem;font-weight:800;text-decoration:none;transition:all .25s;box-shadow:0 4px 14px rgba(37,211,102,.3)}
.nw:hover{background:#1ebe5d;transform:translateY(-2px)}
.nw svg{width:14px;height:14px}
.ham{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px}
.ham span{width:22px;height:2px;background:var(--text);border-radius:99px}
@media(max-width:1024px){.nm{display:none}.ham{display:flex}}
.mob{position:fixed;inset:0;z-index:890;background:rgba(255,255,255,.98);backdrop-filter:blur(20px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;transform:translateX(100%);transition:transform .4s}
.mob.open{transform:none}
.mob a{font-size:1.5rem;font-weight:800;color:var(--text);text-decoration:none;transition:color .2s}
.mob a:hover{color:var(--b)}
.mob-x{position:absolute;top:22px;right:22px;width:40px;height:40px;border:1.5px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;color:var(--muted)}

/* ── HERO ── */
#hero{min-height:100vh;background:var(--off);display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:90px 5% 60px;gap:60px;position:relative;overflow:hidden;max-width:100%}
.hero-blob{position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(21,101,192,.08),transparent 70%);top:-200px;right:-200px;pointer-events:none}
.hero-blob2{position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(66,165,245,.06),transparent 70%);bottom:-100px;left:30%;pointer-events:none}
.hero-left{position:relative;z-index:2;max-width:620px}
.hero-tag{display:inline-flex;align-items:center;gap:8px;background:rgba(21,101,192,.08);border:1px solid rgba(21,101,192,.15);border-radius:50px;padding:6px 16px;margin-bottom:24px}
.hero-tag-dot{width:6px;height:6px;border-radius:50%;background:var(--b);animation:dp 2s infinite}
@keyframes dp{0%,100%{opacity:1}50%{opacity:.4}}
.hero-tag span{font-size:.66rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--b)}
.hero-h1{font-family:'Nunito',sans-serif;font-size:clamp(2.8rem,4.5vw,5rem);font-weight:900;color:var(--text);line-height:1.02;letter-spacing:-.03em;margin-bottom:8px}
.hero-h1 .azul{color:var(--b)}
.hero-h2{font-family:'Nunito',sans-serif;font-size:clamp(1.4rem,2vw,1.9rem);font-weight:700;color:var(--b);line-height:1.2;letter-spacing:-.02em;margin-bottom:20px}
.hero-p{font-size:.96rem;color:var(--muted);line-height:1.85;margin-bottom:28px;font-weight:400;max-width:500px}
.hero-tipos{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px}
.htipo{display:flex;align-items:center;gap:12px;background:var(--w);border:1.5px solid var(--border);border-radius:16px;padding:14px 18px;cursor:pointer;transition:all .3s;font-family:'Nunito Sans',sans-serif;box-shadow:var(--s1)}
.htipo:hover,.htipo.on{border-color:var(--b);box-shadow:var(--s2);transform:translateY(-2px);background:linear-gradient(135deg,rgba(21,101,192,.04),rgba(25,118,210,.02))}
.htipo-ico{width:38px;height:38px;border-radius:12px;background:var(--off);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .3s}
.htipo:hover .htipo-ico,.htipo.on .htipo-ico{background:var(--b)}
.htipo:hover .htipo-ico svg,.htipo.on .htipo-ico svg{stroke:#fff}
.htipo-ico svg{width:19px;height:19px;stroke:var(--b);fill:none;transition:stroke .3s;stroke-width:2}
.htipo-t{font-size:.88rem;font-weight:800;color:var(--text);margin-bottom:1px;letter-spacing:-.01em}
.htipo-s{font-size:.68rem;color:var(--muted)}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:36px}
.btn-p{display:inline-flex;align-items:center;gap:9px;background:var(--b);color:#fff;padding:14px 28px;border-radius:50px;font-weight:800;font-size:.84rem;text-decoration:none;border:none;cursor:pointer;font-family:'Nunito Sans',sans-serif;transition:all .3s;box-shadow:0 6px 24px rgba(21,101,192,.4)}
.btn-p:hover{background:var(--b2);transform:translateY(-3px);box-shadow:0 12px 36px rgba(21,101,192,.5)}
.btn-p svg{width:17px;height:17px}
.btn-g{display:inline-flex;align-items:center;gap:9px;background:var(--g);color:#fff;padding:14px 26px;border-radius:50px;font-weight:800;font-size:.84rem;text-decoration:none;transition:all .3s;box-shadow:0 6px 20px rgba(37,211,102,.4)}
.btn-g:hover{background:#1ebe5d;transform:translateY(-3px)}
.btn-g svg{width:17px;height:17px}
.btn-o{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--b);padding:13px 22px;border-radius:50px;font-weight:700;font-size:.82rem;text-decoration:none;border:1.5px solid rgba(21,101,192,.3);transition:all .3s}
.btn-o:hover{border-color:var(--b);background:rgba(21,101,192,.05)}
.hero-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.hst{background:var(--w);border-radius:16px;padding:14px 10px;text-align:center;box-shadow:var(--s1);border:1px solid var(--border);transition:all .3s}
.hst:hover{transform:translateY(-3px);box-shadow:var(--s2)}
.hst-ico{font-size:1.4rem;margin-bottom:4px}
.hst-n{font-family:'Nunito',sans-serif;font-size:1.4rem;font-weight:900;color:var(--b);line-height:1;letter-spacing:-.03em}
.hst-l{font-size:.56rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-top:2px;line-height:1.3}
.hero-right{position:relative;z-index:2}
.hero-img{border-radius:28px;overflow:hidden;box-shadow:var(--s3);aspect-ratio:4/5;background:linear-gradient(135deg,#1565C0,#42A5F5)}
.hero-img img{width:100%;height:100%;object-fit:cover}
.hfc{position:absolute;background:var(--w);border-radius:20px;box-shadow:var(--s2);padding:14px 18px;border:1px solid var(--border);display:flex;align-items:center;gap:11px;animation:fl 4s ease-in-out infinite}
@keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.hfc1{bottom:48px;left:-36px;animation-delay:0s}
.hfc2{top:48px;right:-28px;animation-delay:1.5s}
.hfc3{bottom:160px;right:-32px;animation-delay:.8s}
.hfc-ico{width:36px;height:36px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.hfc-t{font-size:.8rem;font-weight:800;color:var(--text);letter-spacing:-.01em}
.hfc-s{font-size:.64rem;color:var(--muted)}
@media(max-width:960px){#hero{grid-template-columns:1fr;padding-top:100px}.hero-img{aspect-ratio:16/9}.hfc{display:none}}

/* ── MARQUEE ── */
.mq{background:linear-gradient(90deg,var(--b2),var(--b),var(--b3));padding:11px 0;overflow:hidden}
.mq-t{display:flex;animation:mqs 30s linear infinite;white-space:nowrap}
.mq-i{font-size:.62rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.8);padding:0 28px;display:flex;align-items:center;gap:12px;flex-shrink:0}
.mq-d{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.4)}
@keyframes mqs{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── SECTIONS ── */
.sec{padding:96px 5%}
.sec-in{max-width:1280px;margin:0 auto}
.chip{display:inline-flex;align-items:center;gap:7px;background:rgba(21,101,192,.07);border:1px solid rgba(21,101,192,.12);border-radius:50px;padding:5px 14px;margin-bottom:16px}
.chip span{font-size:.62rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--b)}
.chip-d{width:5px;height:5px;border-radius:50%;background:var(--b)}
h2{font-family:'Nunito',sans-serif;font-size:clamp(2rem,3.5vw,3.2rem);font-weight:900;color:var(--text);line-height:1.05;letter-spacing:-.03em;margin-bottom:14px}
h2 em{font-style:italic;color:var(--b)}
.sub{font-size:.93rem;color:var(--muted);line-height:1.85;max-width:500px}
[data-r]{opacity:0;transform:translateY(28px);transition:opacity .65s cubic-bezier(.4,0,.2,1),transform .65s cubic-bezier(.4,0,.2,1)}
[data-r].on{opacity:1;transform:none}

/* ── DESTINOS ── */
#destinos{background:var(--w)}
.dest-intro{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end;margin-bottom:48px}
.dg{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.dc{border-radius:24px;overflow:hidden;background:var(--w);border:1.5px solid var(--border);box-shadow:var(--s1);transition:all .4s;cursor:pointer}
.dc:hover{transform:translateY(-8px);box-shadow:var(--s3);border-color:rgba(21,101,192,.2)}
.dc-img{height:200px;position:relative;overflow:hidden;background:linear-gradient(135deg,#1565C0,#1976D2)}
.dc-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.dc:hover .dc-img img{transform:scale(1.07)}
.dc-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(10,22,40,.88) 0%,transparent 55%)}
.dc-info{position:absolute;bottom:0;left:0;right:0;padding:14px 18px;display:flex;align-items:flex-end;justify-content:space-between}
.dc-name{font-family:'Nunito',sans-serif;font-size:1.15rem;font-weight:900;color:#fff;letter-spacing:-.02em}
.dc-pr{font-size:.58rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:rgba(21,101,192,.85);padding:4px 10px;border-radius:50px}
.dc-body{padding:18px 20px 16px}
.dc-desc{font-size:.78rem;color:var(--muted);line-height:1.72;margin-bottom:12px}
.dc-tags{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px}
.dtag{font-size:.6rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--b);background:var(--b5);border-radius:50px;padding:3px 10px;border:1px solid rgba(21,101,192,.1)}
.dc-btns{display:flex;gap:6px;flex-wrap:wrap}
.bs{display:inline-flex;align-items:center;gap:4px;padding:8px 14px;border-radius:50px;font-size:.72rem;font-weight:800;text-decoration:none;transition:all .25s;border:none;cursor:pointer;font-family:'Nunito Sans',sans-serif}
.bs-b{background:var(--b);color:#fff;box-shadow:0 3px 12px rgba(21,101,192,.3)}.bs-b:hover{background:var(--b2)}
.bs-d{background:var(--off);color:var(--text);border:1.5px solid var(--border)}.bs-d:hover{border-color:var(--b);color:var(--b)}
.bs-g{background:var(--g);color:#fff}.bs-g:hover{background:#1ebe5d}
.bs svg{width:11px;height:11px}

/* ── PROGRAMAS ── */
#programas{background:linear-gradient(135deg,#0A1628 0%,#0D47A1 60%,#1565C0 100%);padding:96px 5%}
.prog-in{max-width:1280px;margin:0 auto}
.prog-intro{text-align:center;max-width:680px;margin:0 auto 60px}
.prog-intro h2{color:var(--w)}
.prog-intro .sub{color:rgba(255,255,255,.55);margin:0 auto}
.prog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.prog-card{border-radius:24px;padding:36px 32px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.06);backdrop-filter:blur(12px);transition:all .35s;position:relative;overflow:hidden}
.prog-card:hover{background:rgba(255,255,255,.1);transform:translateY(-6px);box-shadow:0 20px 60px rgba(0,0,0,.3)}
.prog-card.featured{background:var(--w);border-color:transparent;box-shadow:var(--s3)}
.prog-glow{position:absolute;width:200px;height:200px;border-radius:50%;background:rgba(66,165,245,.12);top:-60px;right:-60px;pointer-events:none}
.prog-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.12);border-radius:50px;padding:4px 12px;margin-bottom:20px;font-size:.6rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.7)}
.prog-card.featured .prog-badge{background:var(--b5);color:var(--b)}
.prog-name{font-family:'Nunito',sans-serif;font-size:1.4rem;font-weight:900;color:var(--w);margin-bottom:8px;letter-spacing:-.03em}
.prog-card.featured .prog-name{color:var(--text)}
.prog-precio{margin-bottom:6px}
.prog-ins{font-size:.72rem;font-weight:600;color:rgba(255,255,255,.45);margin-bottom:4px}
.prog-card.featured .prog-ins{color:var(--muted)}
.prog-val{font-family:'Nunito',sans-serif;font-size:2.4rem;font-weight:900;color:var(--w);line-height:1;letter-spacing:-.04em}
.prog-card.featured .prog-val{color:var(--b)}
.prog-val span{font-size:.9rem;font-weight:600;vertical-align:super;margin-right:2px}
.prog-sep{height:1px;background:rgba(255,255,255,.1);margin:20px 0}
.prog-card.featured .prog-sep{background:var(--border)}
.prog-list{display:flex;flex-direction:column;gap:9px;margin-bottom:28px}
.prog-li{display:flex;align-items:flex-start;gap:9px;font-size:.8rem;color:rgba(255,255,255,.7);font-weight:500;line-height:1.5}
.prog-card.featured .prog-li{color:var(--muted)}
.prog-li::before{content:'';width:16px;height:16px;border-radius:50%;background:rgba(66,165,245,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 8l3 3 7-7' stroke='%2342A5F5' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:center;background-size:12px}
.prog-card.featured .prog-li::before{background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 8l3 3 7-7' stroke='%231565C0' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E")}
.prog-cta{width:100%;padding:14px;border-radius:50px;font-family:'Nunito Sans',sans-serif;font-size:.82rem;font-weight:800;cursor:pointer;transition:all .3s;border:1.5px solid rgba(255,255,255,.25);background:transparent;color:var(--w);letter-spacing:.02em}
.prog-cta:hover{background:rgba(255,255,255,.12)}
.prog-card.featured .prog-cta{background:var(--b);color:#fff;border-color:transparent;box-shadow:0 6px 22px rgba(21,101,192,.4)}
.prog-card.featured .prog-cta:hover{background:var(--b2);transform:translateY(-2px)}
@media(max-width:900px){.prog-grid{grid-template-columns:1fr}}

/* ── SOBRE NOSOTROS ── */
#nosotros{background:var(--w)}
.nos-g{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;margin-top:56px}
.nos-img{border-radius:24px;overflow:hidden;box-shadow:var(--s3);position:relative;aspect-ratio:4/5;background:linear-gradient(135deg,#1565C0,#42A5F5)}
.nos-img img{width:100%;height:100%;object-fit:cover}
.nos-badge{position:absolute;bottom:24px;left:24px;background:rgba(255,255,255,.95);backdrop-filter:blur(12px);border-radius:18px;padding:16px 20px;box-shadow:var(--s2);display:flex;align-items:center;gap:12px;border:1px solid rgba(255,255,255,.8)}
.nb-ico{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--b),var(--b3));display:flex;align-items:center;justify-content:center;font-size:1.2rem}
.nb-n{font-family:'Nunito',sans-serif;font-size:1.5rem;font-weight:900;color:var(--b);line-height:1;letter-spacing:-.04em}
.nb-l{font-size:.64rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-top:1px}
.nos-feats{display:flex;flex-direction:column;gap:14px;margin:28px 0 32px}
.nf{display:flex;gap:14px;align-items:flex-start;background:var(--off);border-radius:16px;padding:16px;border:1px solid var(--border);transition:all .3s}
.nf:hover{box-shadow:var(--s1);border-color:rgba(21,101,192,.2);transform:translateX(4px)}
.nf-ico{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,rgba(21,101,192,.1),rgba(25,118,210,.15));display:flex;align-items:center;justify-content:center;flex-shrink:0}
.nf-ico svg{width:20px;height:20px;stroke:var(--b);fill:none;stroke-width:1.8}
.nf-t{font-size:.86rem;font-weight:800;color:var(--text);margin-bottom:2px;letter-spacing:-.01em}
.nf-d{font-size:.78rem;color:var(--muted);line-height:1.65}
@media(max-width:900px){.nos-g{grid-template-columns:1fr}.nos-img{aspect-ratio:16/9}}

/* ── SERVICIOS ── */
#servicios{background:var(--off)}
.sg{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px}
.sc{background:var(--w);border-radius:24px;padding:36px 28px;border:1.5px solid var(--border);box-shadow:var(--s1);transition:all .35s;position:relative;overflow:hidden}
.sc::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--b),var(--b3));transform:scaleX(0);transform-origin:left;transition:transform .4s;border-radius:0 0 24px 24px}
.sc:hover{transform:translateY(-6px);box-shadow:var(--s2);border-color:rgba(21,101,192,.2)}
.sc:hover::after{transform:scaleX(1)}
.sc-n{font-size:.56rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:rgba(21,101,192,.3);margin-bottom:16px}
.sc-ico{width:48px;height:48px;border-radius:16px;background:var(--b5);display:flex;align-items:center;justify-content:center;margin-bottom:16px;transition:all .3s}
.sc:hover .sc-ico{background:var(--b)}
.sc:hover .sc-ico svg{stroke:#fff}
.sc-ico svg{width:24px;height:24px;stroke:var(--b);fill:none;stroke-width:1.8;transition:stroke .3s}
.sc-t{font-family:'Nunito',sans-serif;font-size:.96rem;font-weight:900;color:var(--text);margin-bottom:8px;letter-spacing:-.02em}
.sc-d{font-size:.78rem;color:var(--muted);line-height:1.8}
@media(max-width:900px){.sg{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.sg{grid-template-columns:1fr}}

/* ── PROCESO ── */
#proceso{background:var(--w)}
.prg{display:grid;grid-template-columns:1fr 1fr;gap:80px;margin-top:56px;align-items:start}
.pasos{display:flex;flex-direction:column;gap:6px}
.paso{display:flex;gap:16px;padding:18px 20px;border-radius:18px;cursor:pointer;transition:all .3s;border:1.5px solid transparent}
.paso:hover{background:var(--off);border-color:var(--border)}
.paso.on{background:var(--b5);border-color:rgba(21,101,192,.2);box-shadow:var(--s1)}
.paso-n{width:36px;height:36px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:'Nunito',sans-serif;font-size:.76rem;font-weight:900;color:var(--muted);flex-shrink:0;transition:all .3s}
.paso.on .paso-n{background:var(--b);color:#fff;border-color:var(--b);box-shadow:0 4px 14px rgba(21,101,192,.35)}
.paso-t{font-size:.88rem;font-weight:800;color:var(--text);margin-bottom:2px;letter-spacing:-.01em;transition:color .25s}
.paso.on .paso-t{color:var(--b)}
.paso-d{font-size:.76rem;color:var(--muted);line-height:1.7;max-height:0;overflow:hidden;transition:max-height .4s,opacity .3s;opacity:0}
.paso.on .paso-d{max-height:200px;opacity:1}
.pp{background:var(--off);border-radius:28px;padding:36px;box-shadow:var(--s2);border:1.5px solid var(--border);position:sticky;top:90px}
.pp-s{font-size:.6rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--b);margin-bottom:10px}
.pp-t{font-family:'Nunito',sans-serif;font-size:1.5rem;font-weight:900;color:var(--text);margin-bottom:10px;letter-spacing:-.03em;line-height:1.1}
.pp-d{font-size:.82rem;color:var(--muted);line-height:1.8;margin-bottom:16px}
.pp-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:20px}
.pp-tag{background:var(--w);color:var(--b);font-size:.6rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:50px;border:1.5px solid rgba(21,101,192,.15)}
.pp-bar{height:4px;background:var(--border);border-radius:99px;overflow:hidden;margin-bottom:20px}
.pp-prog{height:100%;background:linear-gradient(90deg,var(--b),var(--b3));border-radius:99px;transition:width .5s cubic-bezier(.4,0,.2,1)}
.pp-box{background:var(--w);border-radius:16px;padding:16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;border:1.5px solid var(--border)}
.pp-box p{font-size:.78rem;font-weight:700;color:var(--text)}
@media(max-width:900px){.prg{grid-template-columns:1fr}.pp{position:static}}

/* ── TESTIMONIOS ── */
#testimonios{background:var(--off)}
.tg{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px}
.tc{background:var(--w);border-radius:24px;padding:30px 26px;border:1.5px solid var(--border);box-shadow:var(--s1);transition:all .35s}
.tc:hover{transform:translateY(-6px);box-shadow:var(--s2);border-color:rgba(21,101,192,.2)}
.tc-stars{display:flex;gap:3px;margin-bottom:12px}
.tc-stars svg{width:14px;height:14px}
.tc-q{font-family:'Nunito',sans-serif;font-size:.9rem;color:var(--muted);line-height:1.8;font-style:italic;margin-bottom:18px}
.tc-a{display:flex;align-items:center;gap:11px;padding-top:14px;border-top:1px solid var(--border)}
.tc-av{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--b),var(--b3));display:flex;align-items:center;justify-content:center;font-family:'Nunito',sans-serif;font-weight:900;color:#fff;font-size:.82rem;flex-shrink:0}
.tc-n{font-size:.86rem;font-weight:800;color:var(--text);margin-bottom:1px;letter-spacing:-.01em}
.tc-i{font-size:.64rem;color:var(--muted)}
@media(max-width:900px){.tg{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.tg{grid-template-columns:1fr}}

/* ── GALERIA ── */
#galeria{background:var(--w)}
.gg{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:220px;gap:14px;margin-top:44px}
.gi{border-radius:22px;overflow:hidden;position:relative;cursor:pointer;box-shadow:var(--s1);transition:all .4s;background:linear-gradient(135deg,#1565C0,#1976D2)}
.gi:nth-child(1){grid-column:span 2;grid-row:span 2}
.gi:nth-child(4){grid-column:span 2}
.gi:hover{transform:translateY(-4px);box-shadow:var(--s2)}
.gi img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.gi:hover img{transform:scale(1.07)}
.gi-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(13,27,42,.7),transparent 50%);opacity:0;transition:opacity .3s}
.gi:hover .gi-ov{opacity:1}
.gi-l{position:absolute;bottom:14px;left:16px;font-size:.64rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#fff;opacity:0;transition:all .35s;transform:translateY(6px)}
.gi:hover .gi-l{opacity:1;transform:translateY(0)}
@media(max-width:768px){.gg{grid-template-columns:1fr 1fr;grid-auto-rows:180px}.gi:nth-child(1),.gi:nth-child(4){grid-column:span 1;grid-row:span 1}}

/* ── BLOG ── */
#blog{background:var(--off)}
.blog-g{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px}
.blog-c{border-radius:24px;overflow:hidden;background:var(--w);border:1.5px solid var(--border);box-shadow:var(--s1);transition:all .35s;cursor:pointer}
.blog-c:hover{transform:translateY(-6px);box-shadow:var(--s2);border-color:rgba(21,101,192,.2)}
.blog-img{height:200px;background:linear-gradient(135deg,#1565C0,#42A5F5);overflow:hidden}
.blog-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.blog-c:hover .blog-img img{transform:scale(1.05)}
.blog-body{padding:24px}
.blog-cat{display:inline-block;font-size:.6rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--b);background:var(--b5);border-radius:50px;padding:3px 10px;margin-bottom:12px;border:1px solid rgba(21,101,192,.1)}
.blog-t{font-family:'Nunito',sans-serif;font-size:1rem;font-weight:900;color:var(--text);margin-bottom:8px;letter-spacing:-.02em;line-height:1.3}
.blog-d{font-size:.78rem;color:var(--muted);line-height:1.7;margin-bottom:14px}
.blog-meta{display:flex;align-items:center;justify-content:space-between}
.blog-fecha{font-size:.68rem;color:var(--muted);font-weight:600}
.blog-link{font-size:.72rem;font-weight:800;color:var(--b);text-decoration:none;display:flex;align-items:center;gap:4px;transition:gap .2s}
.blog-link:hover{gap:8px}
@media(max-width:900px){.blog-g{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.blog-g{grid-template-columns:1fr}}

/* ── CTA FINAL ── */
#cta-f{background:linear-gradient(135deg,var(--b5) 0%,#E8F4FF 50%,var(--b5) 100%);padding:120px 5%;text-align:center;position:relative;overflow:hidden}
.cta-blob{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(21,101,192,.07),transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}
.cta-in{position:relative;z-index:2;max-width:640px;margin:0 auto}
.cta-badge{display:inline-flex;align-items:center;gap:7px;background:var(--w);border:1.5px solid rgba(21,101,192,.15);border-radius:50px;padding:6px 18px;margin-bottom:20px;box-shadow:var(--s1)}
.cta-badge span{font-size:.62rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--b)}
.cta-t{font-family:'Nunito',sans-serif;font-size:clamp(2.4rem,5vw,4.5rem);font-weight:900;color:var(--text);line-height:.98;letter-spacing:-.04em;margin-bottom:18px}
.cta-t em{font-style:italic;color:var(--b)}
.cta-s{font-size:.95rem;color:var(--muted);max-width:420px;margin:0 auto 40px;line-height:1.85}
.cta-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:36px}
.cta-meta{display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap}
.cta-m{font-size:.7rem;font-weight:700;color:var(--muted);display:flex;align-items:center;gap:6px}
.cta-m::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--b);flex-shrink:0}

/* ── FOOTER ── */
footer{background:var(--dark);padding:72px 5% 28px;border-top:1px solid rgba(255,255,255,.04)}
.fg{display:grid;grid-template-columns:1.8fr 1fr 1fr 1fr;gap:48px;margin-bottom:48px}
.f-logo img{height:54px;margin-bottom:10px}
.f-tag{font-size:.6rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.2);margin-bottom:12px}
.f-desc{font-size:.76rem;color:rgba(255,255,255,.35);line-height:1.8;max-width:220px;margin-bottom:20px}
.f-soc{display:flex;gap:8px;margin-bottom:20px}
.fss{width:34px;height:34px;border:1px solid rgba(255,255,255,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;text-decoration:none;transition:all .25s}
.fss:hover{background:var(--b);border-color:var(--b);transform:translateY(-2px)}
.fss svg{width:14px;height:14px}
.fwa{display:flex;align-items:center;gap:10px;background:rgba(37,211,102,.08);border:1px solid rgba(37,211,102,.15);border-radius:14px;padding:12px 14px;text-decoration:none;transition:all .3s}
.fwa:hover{background:rgba(37,211,102,.14)}
.fwa svg{width:17px;height:17px;flex-shrink:0}
.fwa-t{font-size:.72rem;color:rgba(255,255,255,.45);line-height:1.3}
.fwa-t strong{display:block;font-size:.78rem;color:var(--w);font-weight:800}
.fc h5{font-size:.6rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.2);margin-bottom:16px}
.fc ul{list-style:none;display:flex;flex-direction:column;gap:9px}
.fc ul li a{font-size:.77rem;color:rgba(255,255,255,.38);text-decoration:none;transition:color .2s}
.fc ul li a:hover{color:#42A5F5}
.fb{border-top:1px solid rgba(255,255,255,.06);padding-top:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.fcp,.frf{font-size:.68rem;color:rgba(255,255,255,.16);letter-spacing:.04em}
@media(max-width:900px){.fg{grid-template-columns:1fr 1fr;gap:28px}}
@media(max-width:600px){.fg{grid-template-columns:1fr}.fb{flex-direction:column;text-align:center}}

/* ── WA FLOAT ── */
.waf{position:fixed;bottom:28px;right:28px;z-index:800}
.waf-b{width:56px;height:56px;background:var(--g);border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 6px 24px rgba(37,211,102,.5);transition:all .3s;animation:wap 3s ease-in-out infinite}
.waf-b:hover{transform:scale(1.12);box-shadow:0 10px 36px rgba(37,211,102,.65)}
.waf-b svg{width:26px;height:26px}
@keyframes wap{0%,100%{box-shadow:0 6px 24px rgba(37,211,102,.5)}50%{box-shadow:0 6px 36px rgba(37,211,102,.7),0 0 0 8px rgba(37,211,102,.1)}}

/* ── MODAL ── */
.mov{position:fixed;inset:0;z-index:9000;background:rgba(10,22,40,.85);backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s;padding:20px}
.mov.open{opacity:1;pointer-events:all}
.mbox{background:var(--w);border-radius:28px;width:100%;max-width:560px;max-height:90vh;overflow-y:auto;transform:translateY(24px) scale(.98);transition:transform .35s cubic-bezier(.34,1.56,.64,1);box-shadow:0 40px 100px rgba(10,22,40,.4)}
.mov.open .mbox{transform:translateY(0) scale(1)}
.mh{background:linear-gradient(135deg,var(--b2),var(--b),var(--b3));padding:28px 32px;border-radius:28px 28px 0 0;position:sticky;top:0}
.mh-b{font-size:.6rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:6px;display:flex;align-items:center;gap:6px}
.mh-b::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--g);box-shadow:0 0 8px rgba(37,211,102,.8)}
.mh-t{font-family:'Nunito',sans-serif;font-size:1.5rem;font-weight:900;color:#fff;margin-bottom:4px;letter-spacing:-.03em}
.mh-s{font-size:.8rem;color:rgba(255,255,255,.55)}
.mc{position:absolute;top:20px;right:20px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.12);border:none;cursor:pointer;color:#fff;font-size:.95rem;display:flex;align-items:center;justify-content:center;transition:all .2s}
.mc:hover{background:rgba(255,255,255,.22);transform:rotate(90deg)}
.mb{padding:28px 32px}
.fr2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fg2{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.fg2 label{font-size:.62rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.fg2 input,.fg2 select,.fg2 textarea{background:var(--off);border:1.5px solid var(--border);border-radius:12px;padding:11px 14px;font-family:'Nunito Sans',sans-serif;font-size:.86rem;color:var(--text);outline:none;transition:all .25s;width:100%}
.fg2 input:focus,.fg2 select:focus,.fg2 textarea:focus{border-color:var(--b);background:var(--w);box-shadow:0 0 0 3px rgba(21,101,192,.1)}
.fg2 textarea{min-height:82px;resize:vertical}
.btn-sub{width:100%;padding:14px;background:linear-gradient(135deg,var(--b2),var(--b));color:#fff;border:none;border-radius:50px;font-family:'Nunito Sans',sans-serif;font-size:.88rem;font-weight:800;cursor:pointer;transition:all .3s;margin-top:4px;box-shadow:0 6px 22px rgba(21,101,192,.35)}
.btn-sub:hover{transform:translateY(-2px);box-shadow:0 10px 32px rgba(21,101,192,.45)}
.btn-mwa{width:100%;margin-top:10px;padding:13px;background:var(--g);color:#fff;border:none;border-radius:50px;font-family:'Nunito Sans',sans-serif;font-size:.84rem;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;transition:all .3s}
.btn-mwa:hover{background:#1ebe5d}
@media(max-width:600px){.fr2{grid-template-columns:1fr}.mov{padding:0;align-items:flex-end}.mbox{border-radius:28px 28px 0 0;max-height:95vh}.mh{border-radius:28px 28px 0 0}}
</style>
</head>

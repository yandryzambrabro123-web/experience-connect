<script>
window.addEventListener('scroll',function(){document.getElementById('nav').classList.toggle('scrolled',scrollY>50)});
document.getElementById('ham').addEventListener('click',function(){document.getElementById('mob').classList.add('open')});
document.getElementById('mobX').addEventListener('click',function(){document.getElementById('mob').classList.remove('open')});
var ro=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('on');ro.unobserve(x.target)}})},{threshold:.08,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('[data-r]').forEach(function(el){ro.observe(el)});
var PD=[
  {t:'Agenda tu asesoría gratuita',d:'Completa el formulario con tu perfil. Un consultor experto te contacta en menos de 24 horas para una sesión personalizada y sin costo.',tags:['24H','Sin costo','Personalizada']},
  {t:'Evaluamos tu perfil completo',d:'Analizamos historial académico, nivel de idioma, presupuesto y metas para encontrar la opción ideal para ti.',tags:['Perfil','Presupuesto','Metas']},
  {t:'País, universidad y programa',d:'Presentamos opciones con costos reales, tasas de empleabilidad y calidad de vida verificada. Tú decides.',tags:['Opciones','Comparativa','Costos reales']},
  {t:'Gestión documental completa',d:'Apostillados, traducciones certificadas, cartas de motivación y formularios de admisión universitaria.',tags:['Apostillado','Traducción','Admisión']},
  {t:'Visa y proceso migratorio',d:'Visa estudiantil, seguro médico internacional y todos los trámites migratorios para tu país destino.',tags:['Visa','Seguro médico','Trámites']},
  {t:'Tu experiencia internacional',d:'Orientación en alojamiento, logística de viaje y adaptación cultural completa en el destino elegido.',tags:['Alojamiento','Orientación','Acompañamiento']}
];
function sp(el,idx){
  document.querySelectorAll('.paso').forEach(function(p){p.classList.remove('on')});
  el.classList.add('on');
  var d=PD[idx];
  document.getElementById('pS').textContent='Paso 0'+(idx+1)+' de 06';
  document.getElementById('pT').textContent=d.t;
  document.getElementById('pD').textContent=d.d;
  document.getElementById('pTg').innerHTML=d.tags.map(function(t){return '<span class="pp-tag">'+t+'</span>'}).join('');
  document.getElementById('pB').style.width=((idx+1)/6*100)+'%';
}
function abrirModal(dest){
  document.getElementById('modal').classList.add('open');
  document.body.style.overflow='hidden';
  if(dest)document.getElementById('mDest').value=dest;
}
function cerrarModal(){document.getElementById('modal').classList.remove('open');document.body.style.overflow='';}
document.addEventListener('keydown',function(e){if(e.key==='Escape')cerrarModal()});
function enviarModal(){
  var n=document.getElementById('mNom').value.trim();
  var w=document.getElementById('mWA').value.trim();
  if(!n||!w){alert('Por favor ingresa tu nombre y WhatsApp.');return;}
  fetch('https://formsubmit.co/ajax/asesoria@experienceconnectec.com',{
    method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify({_subject:'Nueva solicitud - Experience Connect',_captcha:'false',nombre:n,whatsapp:w,email:document.getElementById('mEM').value,perfil:document.getElementById('mPerfil').value,destino:document.getElementById('mDest').value,fecha:document.getElementById('mFecha').value,carrera:document.getElementById('mCar').value,mensaje:document.getElementById('mMsg').value})
  }).catch(function(){});
  cerrarModal();
  alert('Solicitud enviada. Te contactaremos en menos de 24 horas.');
}
</script>
</body>
</html>